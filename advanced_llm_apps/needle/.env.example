# Direct Jev API key from the TypeSafe console (preferred for a Jev API key).
# The backend also recognizes `apikey_` TypeSafe keys in AI_GATEWAY_API_KEY.
TYPESAFE_API_KEY=

# Optional Vercel AI Gateway key for calling Jev through that gateway instead.
# This stays on the backend. Never use a VITE_ prefix for secrets.
AI_GATEWAY_API_KEY=

# Backend OpenAI key for Realtime voice and text list updates.
# Never put this in the Chrome extension or a VITE_ variable.
OPENAI_API_KEY=

# Required on Vercel. Optional for a loopback-only local backend.
# Share this app-specific token only with people allowed to use your backend.
# Enter the same token in Needle extension settings / the web app's How it works dialog.
NEEDLE_ACCESS_TOKEN=

# Optional local port (default 4199).
PORT=4199

# Alternative to the key variables above: explicit local credential file path.
# AI_GATEWAY_KEY_FILE=/absolute/path/to/key
