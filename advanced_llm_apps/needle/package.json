{
  "name": "needle-meaning-find",
  "version": "1.2.9",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run package:extension",
    "dev": "node server/dev.mjs",
    "build": "npm run package:extension && vite build",
    "package:extension": "node scripts/package-extension.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview": "node server/dev.mjs --production",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "fflate": "^0.8.2",
    "prettier": "^3.6.2",
    "vite": "^6.1.0"
  },
  "description": "Woolworths and Coles catalogue search with Jev, Voice, and a shared shopping list",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  }
